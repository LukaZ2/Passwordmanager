<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.Button?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<VBox alignment="CENTER" spacing="20" xmlns:fx="http://javafx.com/fxml" fx:controller="me.passwordmanager.ui.CreateNewMenuController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Text text="Create new database"/>
    <Label text="Name"/>
    <TextField fx:id="nameField"/>
    <Label text="Creation directory:"/>
    <TextField fx:id="directoryField"/>
    <Button text="Create" onAction="#createButtonClick"/>

</VBox>
