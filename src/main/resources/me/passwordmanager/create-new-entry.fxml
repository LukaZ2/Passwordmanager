<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="me.passwordmanager.ui.CreateNewEntryMenuController"
      spacing="10"
      alignment="CENTER"
      prefHeight="400.0" prefWidth="600.0">

    <padding>
        <Insets left="20" right="20" bottom="20" top="20"/>
    </padding>

    <HBox alignment="CENTER" spacing="10">
        <VBox spacing="12">
            <Label text="Title"/>
            <Label text="Username"/>
            <Label text="Password"/>
            <Label text="URL"/>
        </VBox>
        <VBox>
            <TextField fx:id="titleField"/>
            <TextField fx:id="usernameField"/>
            <HBox spacing="5">
                <Group>
                    <PasswordField fx:id="passwordField"/>
                    <TextField fx:id="revealedPasswordField" visible="false"/>
                </Group>
                <Button text="X" onAction="#onClickRevealPassword"/>
                <Button text="Generate" onAction="#onClickedGenerate"/>
            </HBox>
            <TextField fx:id="urlField"/>
        </VBox>
    </HBox>
    <Label text="Description"/>
    <TextArea fx:id="descriptionArea"/>

    <Button text="Create" onAction="#onClickCreate"/>

</VBox>
