<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="500" prefWidth="600" spacing="20" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="me.passwordmanager.ui.DatabaseMenuController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox spacing="20" alignment="CENTER">
        <Button onAction="#onClickCreateNew" text="New entry" />
    </HBox>

    <TableView fx:id="tableView" VBox.vgrow="SOMETIMES">
        <columns>
            <TableColumn fx:id="titleColumn" text="Title" />
            <TableColumn fx:id="usernameColumn" text="Username" />
            <TableColumn fx:id="urlColumn" text="URL" />
            <TableColumn fx:id="categoriesColumn" text="Categories" />
            <TableColumn fx:id="descriptionColumn" text="Description" />
            <TableColumn fx:id="modifiedColumn" text="Modified" />
            <TableColumn fx:id="createdColumn" text="Created" />
        </columns>
    </TableView>

</VBox>
